# Chronicle Shield - Backend Environment Configuration
PROJECT_NAME="Chronicle Shield"
ENVIRONMENT="development"
TESTING=false

# Supabase Credentials (Private backend keys only)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-service-role-key-never-expose-to-frontend"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Storage Settings
STORAGE_BUCKET="evidence"
MAX_FILE_SIZE_BYTES=26214400 # 25 MB
STORAGE_LOCAL_FALLBACK_DIR="./storage_data"

# Database Connection (Postgres / Supabase connection pool or SQLite for testing)
DATABASE_URL="postgresql://postgres:yourpassword@db.your-project.supabase.co:5432/postgres"

# LLM Configuration (Module 3)
LLM_PROVIDER=
GEMINI_API_KEY=
LLM_MODEL=
